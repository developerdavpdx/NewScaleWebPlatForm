
@{
    ViewBag.Title = "Ordenes de Fabricación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Styles/OrdenesFabricacion.css?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Styles/OrdenesFabricacion.css")).Ticks" rel="stylesheet" />

<div class="of-page">

    <div class="of-header">
        <div>
            <h2 class="of-title">Órdenes de fabricación</h2>
            <p class="of-subtitle">Consulta las órdenes activas y accede al detalle de cada una.</p>
        </div>
        <div class="of-tools">
            <span class="of-count"><b id="ofCount">0</b> órdenes</span>
            <button type="button" class="of-refresh" onclick="recargarOrdenes()">
                <i class="fa fa-rotate-right" aria-hidden="true"></i>
                Actualizar
            </button>
        </div>
    </div>

    <div class="of-card">
        <table id="tablaOrdenesFabricacion" class="table of-table">
            <thead>
                <tr>
                    <th>Num. Documento</th>
                    <th>Clave</th>
                    <th>Código</th>
                    <th style="width: 33% !important;">Descripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="bodyTableOF">
            </tbody>
        </table>
    </div>
</div>

@*<script src="~/Scripts/EmailTXT/EmailTXT.js"></script>*@
<script src="~/Scripts/OrdenesFabricacion/OrdenesFabricacion.js?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Scripts/OrdenesFabricacion/OrdenesFabricacion.js")).Ticks"></script>
