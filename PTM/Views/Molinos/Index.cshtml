@{
    ViewBag.Title = "Inventario físico de scrap y molinos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Styles/Molinos/InventarioScrapMolinos/InventarioScrapMolinos.css?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Styles/Molinos/InventarioScrapMolinos/InventarioScrapMolinos.css")).Ticks" rel="stylesheet" />
<link href="~/Styles/Modales.css?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Styles/Modales.css")).Ticks" rel="stylesheet" />

<div class="container-fluid mi-page">

    <div class="mi-header">
        <div>
            <h2 class="mi-title">Inventario físico de scrap y molinos</h2>
            <p class="mi-subtitle">Existencias por proceso, categoría y estado del material.</p>
        </div>

        @if (Session["Rol"].ToString() == "AdmMolinos" || Session["Rol"].ToString() == "Consulta")
        {
            <div class="mi-tools">
                <button type="button" class="mi-btn mi-btn-excel" onclick="generarexcel()">
                    <i class="fa fa-file-excel-o" aria-hidden="true"></i>
                    Excel
                </button>
                <button type="button" class="mi-btn mi-btn-pdf" onclick="generarpdf()">
                    <i class="fa fa-file-pdf-o" aria-hidden="true"></i>
                    PDF
                </button>
                <button type="button" class="mi-btn mi-btn-outline" data-toggle="modal" data-target="#CorreoModal">
                    <i class="fa fa-envelope" aria-hidden="true"></i>
                    Correo
                </button>
                @if (Session["Rol"].ToString() == "AdmMolinos")
                {
                    <button type="button" class="mi-btn mi-btn-primary" data-toggle="modal" data-target="#AgregarAcumulado">
                        <i class="fa fa-plus" aria-hidden="true"></i>
                        Agregar acumulado
                    </button>
                }
            </div>
        }
    </div>

    <div class="mi-card">
        <div class="mi-card-head">
            <i class="fa fa-cubes" aria-hidden="true"></i>
            <h5>Inventario por proceso</h5>
            <span class="mi-card-note">Existencias y acumulados de embarque</span>
        </div>

        <div class="mi-table-wrap">
            <table class="mi-table" id="tablePTMWindMill">
                <thead>
                    <tr>
                        <th>Proceso</th>
                        <th>Categoría</th>
                        <th>Estado</th>
                        <th>Scrap</th>
                        <th>Viruta</th>
                        <th>Molido</th>
                        <th>Pulverizado</th>
                        <th>Polvo de filtros de vacío</th>
                        <th>Compuesto virgen en saco</th>
                        <th>Acumulado entrega de merma</th>
                    </tr>
                </thead>
                <tbody id="bodytab">
                    <tr>
                        <td colspan="10" class="mi-loading">
                            <i class="fa fa-spinner fa-spin" aria-hidden="true"></i>
                            Cargando inventario...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

@* ================= Modal de correo ================= *@
<div class="modal fade mi-modal" id="CorreoModal" tabindex="-1" role="dialog" aria-labelledby="correoModalLabel">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">

            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="fa fa-envelope" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom" id="correoModalLabel">Envío de reporte</div>
                        <div class="modal-subtitle-custom">Inventario físico de scrap y molinos</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-dismiss="modal" aria-label="Cerrar">
                    <i class="fa fa-times" aria-hidden="true"></i>
                </button>
            </div>

            <div class="modal-body-custom">
                <div class="modal-banner-info">
                    <i class="fa fa-info-circle" aria-hidden="true"></i>
                    El reporte se enviará a los correos registrados en la lista.
                </div>
                <table id="tablaCorreo" class="mi-table-sm">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Departamento</th>
                            <th>Correo</th>
                        </tr>
                    </thead>
                    <tbody class="text-center">
                    </tbody>
                </table>
            </div>

            <div class="modal-footer-custom">
                <button type="button" class="btn-modal-cancelar" data-dismiss="modal">
                    <i class="fa fa-times" aria-hidden="true"></i>
                    Cancelar
                </button>
                <button type="button" class="btn-modal-guardar" onclick="emailreporte()">
                    <i class="fa fa-paper-plane" aria-hidden="true"></i>
                    Enviar
                </button>
            </div>

        </div>
    </div>
</div>

@* ================= Modal agregar acumulado ================= *@
<div class="modal fade mi-modal" id="AgregarAcumulado" tabindex="-1" role="dialog" aria-labelledby="acumuladoModalLabel">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">

            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="fa fa-plus" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom" id="acumuladoModalLabel">Agregar acumulado de embarque</div>
                        <div class="modal-subtitle-custom">Registro manual de merma de embarque</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" data-dismiss="modal" aria-label="Cerrar">
                    <i class="fa fa-times" aria-hidden="true"></i>
                </button>
            </div>

            <div class="modal-body-custom">
                <div class="modal-banner-info">
                    <i class="fa fa-info-circle" aria-hidden="true"></i>
                    El registro se agrega a la planta actual con la fecha y hora en que se guarde.
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label-custom" for="staticPeso">Peso</label>
                        <input type="number" class="form-control-custom" id="staticPeso" placeholder="0.00" step="0.01" />
                    </div>
                    <div class="col-12">
                        <label class="form-label-custom" for="selectProces">Proceso</label>
                        <select class="form-select-custom" id="selectProces" onchange="obtenerFamiliasProceso(this)">
                            <option value="0" selected>Seleccione...</option>
                            <option value="1">INY</option>
                            <option value="2">PVC</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label-custom" for="selectSubFam">Sub familia</label>
                        <select class="form-select-custom" id="selectSubFam" disabled>
                            <option value="0" selected>Seleccione...</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="modal-footer-custom">
                <button type="button" class="btn-modal-cancelar" data-dismiss="modal" id="closeModal">
                    <i class="fa fa-times" aria-hidden="true"></i>
                    Cancelar
                </button>
                <button type="button" class="btn-modal-guardar" onclick="GuardarAcumulado()">
                    <i class="fa fa-floppy-o" aria-hidden="true"></i>
                    Guardar
                </button>
            </div>

        </div>
    </div>
</div>

<script src="~/Scripts/Molinos/MolinosJs.js?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Scripts/Molinos/MolinosJs.js")).Ticks"></script>
