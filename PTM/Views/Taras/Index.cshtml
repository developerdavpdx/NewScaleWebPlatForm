@{
    ViewBag.Title = "Taras y Kg/Hora";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Styles/Taras.css?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Styles/Taras.css")).Ticks" rel="stylesheet" />

<div class="taras-page">

    @* ================= ENCABEZADO ================= *@
    <div class="taras-header">
        <div>
            <h2 class="taras-title">Actualización de taras y kg/hora</h2>
            <p class="taras-subtitle">Carga el archivo de Excel, revisa la previsualización y confirma para actualizar los datos maestros.</p>
        </div>
        <div class="taras-tools">
            <span class="taras-pill taras-pill-muted">
                <i class="fa fa-file-excel-o" aria-hidden="true"></i>
                Formato .xlsx / .xls
            </span>
        </div>
    </div>

    @* ================= TARAS ================= *@
    <section class="taras-section">
        <div class="taras-card">

            <div class="taras-card-head">
                <i class="fa fa-balance-scale" aria-hidden="true"></i>
                <h5>Taras</h5>
                <span class="taras-pill"><b id="tarasCount">0</b> registros</span>
            </div>

            <div class="taras-card-body">

                <div class="taras-upload">
                    <label class="taras-file" for="archivoexcel">
                        <input type="file" name="archivoexcel" id="archivoexcel" accept=".xlsx, .xls" />
                        <span class="taras-file-btn">
                            <i class="fa fa-folder-open" aria-hidden="true"></i>
                            Seleccionar archivo
                        </span>
                        <span class="taras-file-name" id="archivoexcelName">Ningún archivo seleccionado</span>
                    </label>

                    <button type="button" id="cargaTaras" class="taras-btn taras-btn-primary">
                        <i class="fa fa-table" aria-hidden="true"></i>
                        Cargar datos
                    </button>
                </div>

                <div class="taras-table-wrap">
                    <table id="tablaDatos" class="table taras-table">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Tara</th>
                                <th>Nombre del ítem</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

            </div>

            <div class="taras-card-foot">
                <span class="taras-foot-note">
                    <i class="fa fa-info-circle" aria-hidden="true"></i>
                    Se actualizan únicamente los códigos del archivo cargado.
                </span>
                <button type="button" id="ActualizaTara" class="taras-btn taras-btn-success">
                    <i class="fa fa-check-circle" aria-hidden="true"></i>
                    Confirmar actualización
                </button>
            </div>

        </div>
    </section>

    @* ================= KG/HORA ================= *@
    <section class="taras-section">
        <div class="taras-card">

            <div class="taras-card-head">
                <i class="fa fa-tachometer" aria-hidden="true"></i>
                <h5>Kg/Hora</h5>
                <span class="taras-pill"><b id="kgHoraCount">0</b> registros</span>
            </div>

            <div class="taras-card-body">

                <div class="taras-upload">
                    <label class="taras-file" for="archivoexcelKgHora">
                        <input type="file" name="archivoexcelKgHora" id="archivoexcelKgHora" accept=".xlsx, .xls" />
                        <span class="taras-file-btn">
                            <i class="fa fa-folder-open" aria-hidden="true"></i>
                            Seleccionar archivo
                        </span>
                        <span class="taras-file-name" id="archivoexcelKgHoraName">Ningún archivo seleccionado</span>
                    </label>

                    <button type="button" id="cargaDatosKgHora" class="taras-btn taras-btn-primary">
                        <i class="fa fa-table" aria-hidden="true"></i>
                        Cargar datos
                    </button>
                </div>

                <div class="taras-table-wrap">
                    <table id="tablaDatosKgHora" class="table taras-table">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Kg/Hora</th>
                                <th>Línea</th>
                                <th>Planta</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

            </div>

            <div class="taras-card-foot">
                <span class="taras-foot-note">
                    <i class="fa fa-info-circle" aria-hidden="true"></i>
                    Se actualizan únicamente los códigos del archivo cargado.
                </span>
                <button type="button" id="ActualizaKgHora" class="taras-btn taras-btn-success">
                    <i class="fa fa-check-circle" aria-hidden="true"></i>
                    Confirmar actualización
                </button>
            </div>

        </div>
    </section>

</div>

<script src="~/Scripts/Taras/Taras.js?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Scripts/Taras/Taras.js")).Ticks"></script>
