@{
    ViewBag.Title = "Historial de pesadas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Styles/HistorialPedida.css?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Styles/HistorialPedida.css")).Ticks" rel="stylesheet" />
<link href="~/Styles/Modales.css" rel="stylesheet" />

<div class="hp-page">

    <div class="hp-header">
        <div>
            <h2 class="hp-title">Historial de pesadas</h2>
            <p class="hp-subtitle">Consulta los pesajes registrados, edita o deshabilita registros y envíalos a SAP.</p>
        </div>
        <div class="hp-tools">
            <span class="hp-pill"><b id="hpCount">0</b> registros</span>
            <button type="button" class="hp-btn hp-btn-ghost hp-btn-excel" onclick="generarexcel()">
                <i class="fa fa-file-excel-o" aria-hidden="true"></i>
                Excel
            </button>
            <button type="button" class="hp-btn hp-btn-outline" data-toggle="modal" data-target="#CorreoModal">
                <i class="fa fa-envelope" aria-hidden="true"></i>
                Correo
            </button>
        </div>
    </div>

    @* ================= FILTROS ================= *@
    <div class="hp-card">
        <div class="hp-card-header">
            <i class="fa fa-filter" aria-hidden="true"></i>
            <h5>Filtros</h5>
            <span class="hp-card-note">Periodo, turno, código, línea y estatus SAP</span>
        </div>
        <div class="hp-card-body">
            <div class="hp-filter-row">
                <div class="hp-field hp-field-date">
                    <label class="hp-label" for="desdeFecha">Fecha</label>
                    <input class="hp-input" type="date" id="desdeFecha" />
                </div>
                <div class="hp-field hp-field-date">
                    <label class="hp-label" for="aFecha">Al</label>
                    <input class="hp-input" type="date" id="aFecha" />
                </div>
                <div class="hp-field hp-field-turno">
                    <label class="hp-label" for="turno">Turno</label>
                    <select id="turno" class="hp-select"></select>
                </div>
                <div class="hp-field hp-field-code">
                    <label class="hp-label" for="codigo">Código</label>
                    <input class="hp-input" id="codigo" />
                </div>
                <div class="hp-field hp-field-line">
                    <label class="hp-label" for="lineaHP">Línea</label>
                    <input class="hp-input" id="lineaHP" />
                </div>
                <div class="hp-field hp-field-status">
                    <label class="hp-label" for="selectEstatus">Estatus SAP</label>
                    <select class="hp-select" id="selectEstatus">
                        <option value="0" selected>Seleccione...</option>
                        <option value="1">Enviado</option>
                        <option value="2">Sin Enviar</option>
                        <option value="3">Error</option>
                    </select>
                </div>
                <div class="hp-filter-actions">
                    <button type="button" class="hp-btn hp-btn-primary" id="search" onclick="filtradoHistorialPesadas()">
                        <i class="fa fa-search" aria-hidden="true"></i>
                        Buscar
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ================= TABLA ================= *@
    <div class="hp-card">
        <div class="hp-card-header">
            <i class="fa fa-tasks" aria-hidden="true"></i>
            <h5>Pesadas registradas</h5>
            <div class="hp-card-tools">
                <label class="hp-check" for="checkboxSelect">
                    <input type="checkbox" id="checkboxSelect" onclick="checkBoxSeleccionar()" />
                    <span>Seleccionar todos</span>
                </label>
                <span class="hp-pill hp-pill-muted"><b id="hpSelected">0</b> seleccionados</span>
            </div>
        </div>
        <div class="hp-card-body hp-card-body-table">
            <table id="PesadasTable" class="tableHP">
                <thead>
                    <tr>
                        <th scope="col"><span class="visually-hidden">Seleccionar</span></th>
                        <th scope="col">Fecha Pesaje</th>
                        <th scope="col">Línea</th>
                        <th scope="col">Código</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Turno</th>
                        <th scope="col">Cantidad</th>
                        <th scope="col">Orden Fabricación</th>
                        <th scope="col">Atado</th>
                        <th scope="col">P.Neto</th>
                        <th scope="col">Tara</th>
                        <th scope="col">Anillo</th>
                        <th scope="col">Fleje</th>
                        <th scope="col">Sobrepeso</th>
                        <th scope="col">Estatus</th>
                        <th scope="col">Estatus SAP</th>
                        <th scope="col">Folio SAP</th>
                        <th scope="col">Comentario SAP</th>
                        <th scope="col">Comentarios</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <tbody id="bodyTablePesadas" class="text-center">
                </tbody>
            </table>
        </div>
        <div class="hp-card-footer">
            <span class="hp-foot-note">
                <i class="fa fa-info-circle" aria-hidden="true"></i>
                Los registros deshabilitados o ya enviados a SAP no se pueden seleccionar.
            </span>
            <button type="button" class="hp-btn hp-btn-primary" onclick="EnviarASap()">
                <i class="fa fa-paper-plane" aria-hidden="true"></i>
                <span class="hp-btn-label">Enviar SAP</span>
            </button>
        </div>
    </div>

    @* ================= MODAL DE CORREO ================= *@
    <div class="modal fade hp-modal" id="CorreoModal" tabindex="-1" role="dialog" aria-labelledby="correoModalLabel">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">

                <div class="modal-header-custom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon-wrap">
                            <i class="fa fa-envelope" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="modal-title-custom" id="correoModalLabel">Envío de correo</div>
                            <div class="modal-subtitle-custom">Historial de pesadas</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close-custom" data-dismiss="modal" aria-label="Cerrar">
                        <i class="fa fa-times" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="modal-body-custom">
                    <div class="modal-banner-info">
                        <i class="fa fa-info-circle" aria-hidden="true"></i>
                        El reporte se enviará a los correos registrados en la lista.
                    </div>
                    <table id="tablaCorreo" class="hp-table-sm">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Departamento</th>
                                <th>Correo</th>
                            </tr>
                        </thead>
                        <tbody class="text-center">
                        </tbody>
                    </table>
                </div>

                <div class="modal-footer-custom">
                    <button type="button" class="btn-modal-cancelar" data-dismiss="modal">
                        <i class="fa fa-times" aria-hidden="true"></i>
                        Cancelar
                    </button>
                    <button type="button" class="btn-modal-guardar">
                        <i class="fa fa-paper-plane" aria-hidden="true"></i>
                        Enviar
                    </button>
                </div>

            </div>
        </div>
    </div>

    @* ================= MODAL DESHABILITAR REGISTRO ================= *@
    <div class="modal fade hp-modal" id="AgregaComenModal" tabindex="-1" role="dialog" aria-labelledby="deshabilitarModalLabel">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">

                <div class="modal-header-custom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon-wrap">
                            <i class="fa fa-ban" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="modal-title-custom" id="deshabilitarModalLabel">Deshabilitar registro</div>
                            <div class="modal-subtitle-custom">El registro dejará de contar para los reportes</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close-custom" data-dismiss="modal" aria-label="Cerrar">
                        <i class="fa fa-times" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="modal-body-custom">
                    <label class="hp-label" for="textAreaComentario">Motivo</label>
                    <textarea class="hp-textarea mt-2" id="textAreaComentario" placeholder="Escribe el motivo por el que se deshabilita el registro"></textarea>
                    <p class="hp-form-note">El motivo se guarda en la bitácora del registro.</p>
                </div>

                <div class="modal-footer-custom">
                    <button type="button" class="btn-modal-cancelar" data-dismiss="modal" id="cerrarModal">
                        <i class="fa fa-times" aria-hidden="true"></i>
                        Cerrar
                    </button>
                    <button type="button" class="btn-modal-guardar danger" id="deshabilita_historialpesadasevent" iddestino="">
                        <i class="fa fa-ban" aria-hidden="true"></i>
                        Deshabilitar
                    </button>
                </div>

            </div>
        </div>
    </div>

    @* ================= MODAL EDITAR REGISTRO ================= *@
    <div class="modal fade hp-modal" id="EdicionRegModal" tabindex="-1" role="dialog" aria-labelledby="edicionModalLabel">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">

                <div class="modal-header-custom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon-wrap">
                            <i class="fa fa-pencil" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="modal-title-custom" id="edicionModalLabel">Editar registro</div>
                            <div class="modal-subtitle-custom">Los cambios quedan registrados en la bitácora</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close-custom" data-dismiss="modal" aria-label="Cerrar">
                        <i class="fa fa-times" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="modal-body-custom">
                    <form class="formulario">
                        <p>
                            <label for="cantidad">Cantidad tubos</label>
                            <input id="cantidad" type="number" name="cantidad" required>
                        </p>
                        <p>
                            <label for="atado">Atado</label>
                            <input id="atado" type="number" name="atado">
                        </p>
                        <p>
                            <label for="pesoNeto">Peso neto</label>
                            <input id="pesoNeto" type="number" name="pesoNeto" required>
                        </p>
                        <p>
                            <label for="tara">Tara</label>
                            <input id="tara" type="number" name="tara" required>
                        </p>
                        <p>
                            <label for="anillo">Anillo</label>
                            <input id="anillo" type="number" name="anillo" required>
                        </p>
                        <p>
                            <label for="fleje">Fleje</label>
                            <input id="fleje" type="number" name="fleje" required>
                        </p>
                        <p>
                            <label for="selectLinea">Línea</label>
                            <select id="selectLinea">
                                <option value="0" selected>Seleccione...</option>
                            </select>
                        </p>
                        <p>
                            <label for="selectSku">Código</label>
                            <select id="selectSku">
                                <option value="0" selected>Seleccione...</option>
                            </select>
                        </p>
                        <p class="full">
                            <label for="comentario">Comentario</label>
                            <textarea id="comentario" name="comentario" required></textarea>
                        </p>
                    </form>
                </div>

                <div class="modal-footer-custom">
                    <button type="button" class="btn-modal-cancelar" data-dismiss="modal" id="cierraModal">
                        <i class="fa fa-times" aria-hidden="true"></i>
                        Cerrar
                    </button>
                    <button type="button" class="btn-modal-cancelar copiar_registro">
                        <i class="fa fa-copy" aria-hidden="true"></i>
                        Copiar
                    </button>
                    <button type="button" id="btn-save" class="btn-modal-guardar" onclick="GuardarEdicion()">
                        <i class="fa fa-save" aria-hidden="true"></i>
                        Guardar
                    </button>
                </div>

            </div>
        </div>
    </div>

    @* ================= MODAL BITACORA ================= *@
    <div class="modal fade hp-modal" id="BitacoraModal" tabindex="-1" role="dialog" aria-labelledby="bitacoraModalLabel">
        <div class="modal-dialog modal-dialog-centered modal-90" role="document">
            <div class="modal-content">

                <div class="modal-header-custom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon-wrap">
                            <i class="fa fa-history" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="modal-title-custom" id="bitacoraModalLabel">Bitácora del registro</div>
                            <div class="modal-subtitle-custom">Historial de modificaciones del pesaje</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close-custom" data-dismiss="modal" aria-label="Cerrar">
                        <i class="fa fa-times" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="modal-body-custom">
                    <div class="hp-table-scroll">
                        <table class="hp-table-sm" id="BitacoraHistorial">
                            <thead>
                                <tr>
                                    <th>Fecha modificación</th>
                                    <th>Trabajador</th>
                                    <th>Peso total</th>
                                    <th>Código</th>
                                    <th>Num. tubos</th>
                                    <th>Atado</th>
                                    <th>Tara</th>
                                    <th>Anillo</th>
                                    <th>Fleje</th>
                                    <th>Línea</th>
                                </tr>
                            </thead>
                            <tbody class="text-center" id="bodyBitacoraPesadas">
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="modal-footer-custom">
                    <button type="button" class="btn-modal-cancelar" data-dismiss="modal" id="cierraModalBitacora">
                        <i class="fa fa-times" aria-hidden="true"></i>
                        Cerrar
                    </button>
                </div>

            </div>
        </div>
    </div>

</div>

<script src="~/Scripts/HistorialPesadas/HistorialPesada.js?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Scripts/HistorialPesadas/HistorialPesada.js")).Ticks"></script>
<script src="~/Scripts/FormulasPTM.js"></script>
