@{
    ViewBag.Title = "Detalle SKU";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Styles/DetallesSku.css?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Styles/DetallesSku.css")).Ticks" rel="stylesheet" />
<link href="~/Styles/Modales.css" rel="stylesheet" />

<div class="container-fluid sku-page">

    <div class="sku-header">
        <div>
            <h2 class="sku-title">Detalle SKU</h2>
            <p class="sku-subtitle"><span id="skuHeaderName">Cargando información del artículo…</span></p>
        </div>
        <div class="sku-tools">
            <span class="sku-code">
                <i class="bi bi-upc-scan" aria-hidden="true"></i>
                <span id="skuHeaderCode">—</span>
            </span>
            <button type="button" class="sku-btn sku-btn-ghost" onclick="history.back()">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Volver
            </button>
            @if (Session["Rol"].ToString() == "Administrador")
            {
                <button type="button" class="sku-btn sku-btn-outline" id="MostrarModalAgregarDatosDeLinea">
                    <i class="bi bi-plus-circle" aria-hidden="true"></i>
                    Agregar Línea
                </button>
                <button type="button" class="sku-btn sku-btn-primary ActualizarSKU">
                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    Guardar cambios
                </button>
            }
        </div>
    </div>

    @* ================= GENERAL ================= *@
    <div class="sku-card">
        <div class="sku-card-header">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <h5>General</h5>
        </div>
        <div class="sku-card-body">
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="sku-label" for="ItemName">Nombre</label>
                    <input class="sku-input" id="ItemName" disabled />
                </div>
                <div class="col-md-4">
                    <label class="sku-label" for="skuCode">SKU</label>
                    <input class="sku-input" id="skuCode" disabled />
                </div>
                <div class="col-md-4">
                    <label class="sku-label" for="CategorySKU">Categoría</label>
                    <input class="sku-input" id="CategorySKU" disabled />
                </div>
                <div class="col-md-4">
                    <label class="sku-label" for="minWeight">Peso mínimo (kg)</label>
                    <input class="sku-input" id="minWeight" disabled />
                </div>
                <div class="col-md-4">
                    <label class="sku-label" for="maxWeight">Peso máximo (kg)</label>
                    <input class="sku-input" id="maxWeight" disabled />
                </div>
            </div>
        </div>
    </div>

    @* ================= MATERIAL EMBALAJE ================= *@
    <div class="sku-card">
        <div class="sku-card-header">
            <i class="bi bi-box-seam" aria-hidden="true"></i>
            <h5>Material embalaje</h5>
        </div>
        <div class="sku-card-body">
            <div class="row g-3">
                <div class="col-lg-6">
                    <label class="sku-label" for="inputMultiplo">Múltiplo</label>
                    <div class="sku-multiplo">
                        <input type="number" class="sku-input sku-multiplo-qty" id="inputMultiplo" min="0" step="any" required />
                        <span class="sku-multiplo-x" aria-hidden="true">X</span>
                        <select class="sku-select" id="selectMulti">
                            <option value="0" selected>Seleccione...</option>
                            <option value="Tarima" data-multiplo="Tarima" id="tarima">Tarima</option>
                            <option value="Atado" data-multiplo="Atado" id="atado">Atado</option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-6">
                    <label class="sku-label" for="inputVariable">Variable (tara kg)</label>
                    <div class="sku-unit">
                        <input type="number" class="sku-input" id="inputVariable" placeholder="Tarimas madera" step="any" />
                        <span class="sku-unit-suffix">kg</span>
                    </div>
                </div>
            </div>

            @* Material de embalaje, lo llenamos desde el script *@
            <div class="sku-subpanel">
                <div class="sku-subpanel-title">
                    <i class="bi bi-layers" aria-hidden="true"></i>
                    Cantidades por material
                </div>
                <div class="row g-3" id="divMatEmb"></div>
            </div>
        </div>
    </div>

    @* ================= DETALLES DE LINEA ================= *@
    <div class="sku-card">
        <div class="sku-card-header">
            <i class="bi bi-diagram-3" aria-hidden="true"></i>
            <h5>Detalles de línea</h5>
        </div>
        <div class="sku-card-body">
            @* titulos *@
            <div class="row g-3 sku-line-heads d-none d-md-flex">
                <div class="col-3 sku-col-title">Kg x Hora</div>
                <div class="col-3 sku-col-title">Último % de eficiencia</div>
                <div class="col-3 sku-col-title">Línea(s)</div>
                <div class="col-3 sku-col-title">Planta</div>
            </div>
            @* contenido, se genera desde el script *@
            <div class="row g-3" id="divDetailsLine"></div>
        </div>
    </div>

</div>

@* Start Modal de agregar datos de Linea *@
<div class="modal fade sku-modal" id="ModalAgregarDatosDeLinea" tabindex="-1" role="dialog" aria-labelledby="agregarDatosLineaLabel">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">

            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-wrap">
                        <i class="bi bi-plus-circle"></i>
                    </div>
                    <div>
                        <div class="modal-title-custom" id="agregarDatosLineaLabel">Agregar datos de línea</div>
                        <div class="modal-subtitle-custom">Registrar kg por hora y línea para este SKU</div>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" onclick="LimpiarYCerrarModal()" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-body-custom">
                <div class="sku-modal-note">
                    <i class="bi bi-info-circle"></i>
                    El código corresponde al SKU que estás consultando.
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label-custom" for="codigoNew">Código</label>
                        <input id="codigoNew" class="form-control-custom" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label-custom" for="KgHoraNew">Kg x Hora</label>
                        <input id="KgHoraNew" class="form-control-custom" inputmode="decimal" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label-custom" for="LineaNew">Línea</label>
                        <input id="LineaNew" class="form-control-custom" inputmode="numeric" />
                    </div>
                </div>
            </div>

            <div class="modal-footer-custom">
                <button type="button" class="btn-modal-cancelar" data-dismiss="modal" id="cerrarModalAddLinea">
                    <i class="bi bi-x-lg"></i>
                    Cancelar
                </button>
                <button type="button" class="btn-modal-guardar" id="AddDatosLineaNew">
                    <i class="bi bi-check-circle"></i>
                    Agregar
                </button>
            </div>

        </div>
    </div>
</div>
@* End Modal *@

<script src="~/Scripts/DetallesSku/DetallesSkuJS.js?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Scripts/DetallesSku/DetallesSkuJS.js")).Ticks"></script>
