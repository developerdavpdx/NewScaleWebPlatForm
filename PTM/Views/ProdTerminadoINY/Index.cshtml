@{
    ViewBag.Title = "Producto terminado INY";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Styles/ProductoTerminado.css?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Styles/ProductoTerminado.css")).Ticks" rel="stylesheet" />
<link href="~/Styles/Modales.css" rel="stylesheet" />

<div class="pt-page">

    <div class="pt-header">
        <div>
            <h2 class="pt-title">Producto terminado inyección</h2>
            <p class="pt-subtitle">Producción de inyección por línea, con totales del periodo y scrap escaneado.</p>
        </div>
        <div class="pt-tools">
            <span class="pt-pill"><b id="ptInyCount">0</b> registros</span>
            <button type="button" class="pt-btn pt-btn-ghost pt-btn-excel" onclick="generarexcel()">
                <i class="fa fa-file-excel-o" aria-hidden="true"></i>
                Excel
            </button>
            <button type="button" class="pt-btn pt-btn-ghost pt-btn-pdf" onclick="generarpdf()">
                <i class="fa fa-file-pdf-o" aria-hidden="true"></i>
                PDF
            </button>
            <button type="button" class="pt-btn pt-btn-outline" data-toggle="modal" data-target="#CorreoModal">
                <i class="fa fa-envelope" aria-hidden="true"></i>
                Correo
            </button>
        </div>
    </div>

    @* ================= FILTROS PRODUCTO TERMINADO ================= *@
    <div class="pt-card">
        <div class="pt-card-header">
            <i class="fa fa-filter" aria-hidden="true"></i>
            <h5>Filtros</h5>
            <span class="pt-card-note">Periodo, turno, código y línea</span>
        </div>
        <div class="pt-card-body">
            <div class="pt-filter-row">
                <div class="pt-field pt-field-date">
                    <label class="pt-label" for="desdeFechaIny">Fecha</label>
                    <input class="pt-input" type="date" id="desdeFechaIny" />
                </div>
                <div class="pt-field pt-field-date">
                    <label class="pt-label" for="aFechaIny">Al</label>
                    <input class="pt-input" type="date" id="aFechaIny" />
                </div>
                <div class="pt-field pt-field-turno">
                    <label class="pt-label" for="turnoINY">Turno</label>
                    <select id="turnoINY" class="pt-select"></select>
                </div>
                <div class="pt-field pt-field-code">
                    <label class="pt-label" for="codigo">Código</label>
                    <input class="pt-input" id="codigo" />
                </div>
                <div class="pt-field pt-field-line">
                    <label class="pt-label" for="linea">Línea</label>
                    <input class="pt-input" id="linea" />
                </div>
                <div class="pt-filter-actions">
                    <button type="button" class="pt-btn pt-btn-primary" id="search" onclick="filtradoHistorialPesadas()">
                        <i class="fa fa-search" aria-hidden="true"></i>
                        Buscar
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ================= TOTALES ================= *@
    <div class="pt-kpis">
        <div class="pt-kpi">
            <span class="pt-kpi-label">P. Neto total</span>
            <span class="pt-kpi-value" id="sumTotal">--</span>
        </div>
        <div class="pt-kpi">
            <span class="pt-kpi-label">P. Unit. estándar</span>
            <span class="pt-kpi-value" id="sumEstandar">--</span>
        </div>
        <div class="pt-kpi pt-kpi-amber">
            <span class="pt-kpi-label">% Sobrepeso</span>
            <span class="pt-kpi-value" id="sumSobrePeso">--</span>
        </div>
        <div class="pt-kpi pt-kpi-green">
            <span class="pt-kpi-label">% Eficiencia</span>
            <span class="pt-kpi-value" id="sumEficiencia">--</span>
        </div>
        <div class="pt-kpi pt-kpi-red">
            <span class="pt-kpi-label">KG Scrap PT</span>
            <span class="pt-kpi-value" id="sumScrapPtKg">--</span>
        </div>
        <div class="pt-kpi pt-kpi-red">
            <span class="pt-kpi-label">% Scrap PT</span>
            <span class="pt-kpi-value" id="sumScrapPt">--</span>
        </div>
    </div>

    @* ================= TABLA PRODUCTO TERMINADO ================= *@
    <div class="pt-card">
        <div class="pt-card-header">
            <i class="fa fa-cube" aria-hidden="true"></i>
            <h5>Producto terminado inyección</h5>
            <span class="pt-card-note">Usa el botón de la primera columna para ver el detalle por línea</span>
        </div>
        <div class="pt-card-body">
            <table id="finishProdTableIny" class="table pt-table">
                <thead>
                    <tr>
                        <th>Detalles</th>
                        <th>Línea</th>
                        <th>Código</th>
                        <th># Atados/Tarima</th>
                        <th># de Piezas</th>
                        <th>P. Neto Total</th>
                        <th>P. Unit. Estándar</th>
                        <th>% Sobrepeso</th>
                        <th class="efficiency-head">% Eficiencia</th>
                        <th>KG Scrap Pt</th>
                        <th class="scrap-head">% ScrapPT</th>
                    </tr>
                </thead>
                <tbody id="tableProductoINY" class="text-center">
                </tbody>
            </table>
        </div>
    </div>

    @* ================= SCRAP ================= *@
    <div class="pt-card">
        <div class="pt-card-header">
            <i class="fa fa-recycle" aria-hidden="true"></i>
            <h5>Scrap escaneado</h5>
            <div class="pt-card-tools">
                <span class="pt-pill"><b id="ptInyScrapCount">0</b> registros</span>
                <span class="pt-pill pt-pill-danger">KG ScrapPT <b id="SumScrapKG">--</b></span>
                <button type="button" class="pt-btn pt-btn-sm pt-btn-ghost pt-btn-excel" onclick="generarexcelScrapIny()">
                    <i class="fa fa-file-excel-o" aria-hidden="true"></i>
                    Excel
                </button>
                <button type="button" class="pt-btn pt-btn-sm pt-btn-ghost pt-btn-pdf" onclick="generarpdfScrapIny()">
                    <i class="fa fa-file-pdf-o" aria-hidden="true"></i>
                    PDF
                </button>
            </div>
        </div>
        <div class="pt-card-body">
            <div class="pt-filter-row pt-scrap-filters">
                <div class="pt-field pt-field-date">
                    <label class="pt-label" for="desdeFechaScrapIny">Fecha</label>
                    <input class="pt-input" type="date" id="desdeFechaScrapIny" />
                </div>
                <div class="pt-field pt-field-date">
                    <label class="pt-label" for="aFechaScrapIny">Al</label>
                    <input class="pt-input" type="date" id="aFechaScrapIny" />
                </div>
                <div class="pt-field pt-field-turno">
                    <label class="pt-label" for="corteIny">Corte</label>
                    <select id="corteIny" class="pt-select">
                        <option value=null selected>Seleccione...</option>
                        <option value="1">Corte 1 (De 5:45 am a 17:44 pm)</option>
                        <option value="2">Corte 2 (De 17:45pm a 5:44 am)</option>
                    </select>
                </div>
                <div class="pt-field pt-field-code">
                    <label class="pt-label" for="codigoScrapIny">Código</label>
                    <input class="pt-input" id="codigoScrapIny" />
                </div>
                <div class="pt-field pt-field-line">
                    <label class="pt-label" for="lineaScrapIny">Línea</label>
                    <input class="pt-input" id="lineaScrapIny" />
                </div>
                <div class="pt-filter-actions">
                    <button type="button" class="pt-btn pt-btn-primary" id="btn21Iny">
                        <i class="fa fa-search" aria-hidden="true"></i>
                        Buscar
                    </button>
                </div>
            </div>

            <table id="finishScrapTableIny" class="table pt-table">
                <thead>
                    <tr>
                        <th>Línea</th>
                        <th>Familia</th>
                        <th>Peso</th>
                        <th>Comentario</th>
                        <th>Fecha y hora</th>
                    </tr>
                </thead>
                <tbody id="tableScrapIny" class="text-center">
                </tbody>
            </table>
        </div>
    </div>

    @* ================= MODAL DE CORREO ================= *@
    <div class="modal fade pt-modal" id="CorreoModal" tabindex="-1" role="dialog" aria-labelledby="correoModalLabel">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">

                <div class="modal-header-custom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon-wrap">
                            <i class="fa fa-envelope" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="modal-title-custom" id="correoModalLabel">Envío de correo</div>
                            <div class="modal-subtitle-custom">Reporte de producto terminado inyección</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close-custom" data-dismiss="modal" aria-label="Cerrar">
                        <i class="fa fa-times" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="modal-body-custom">
                    <div class="modal-banner-info">
                        <i class="fa fa-info-circle" aria-hidden="true"></i>
                        El reporte se enviará a los correos registrados en la lista.
                    </div>
                    <table id="tablaCorreo" class="table pt-table pt-table-sm">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Departamento</th>
                                <th>Correo</th>
                            </tr>
                        </thead>
                        <tbody class="text-center">
                        </tbody>
                    </table>
                </div>

                <div class="modal-footer-custom">
                    <button type="button" class="btn-modal-cancelar" data-dismiss="modal">
                        <i class="fa fa-times" aria-hidden="true"></i>
                        Cancelar
                    </button>
                    <button type="button" class="btn-modal-guardar" onclick="emailreporte()">
                        <i class="fa fa-paper-plane" aria-hidden="true"></i>
                        Enviar
                    </button>
                </div>

            </div>
        </div>
    </div>

    @* ================= MODAL DETALLE DE LÍNEA ================= *@
    <div class="modal fade pt-modal" id="dataInyModal" style="display: none; overflow: auto;" tabindex="-1" role="dialog" aria-labelledby="detalleLineaLabel">
        <div class="modal-dialog modal-dialog-centered modal-90" role="document">
            <div class="modal-content">

                <div class="modal-header-custom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon-wrap">
                            <i class="fa fa-line-chart" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="modal-title-custom" id="detalleLineaLabel">
                                Detalle de línea
                                <span class="pt-modal-badge" id="lineaModal"></span>
                            </div>
                            <div class="modal-subtitle-custom">INY · Línea <b id="lineaTitleModal"></b> · producción por pesada</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close-custom pt-close-detalle" aria-label="Cerrar">
                        <i class="fa fa-times" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="modal-body-custom">
                    <div class="pt-line-kpis">
                        <div class="pt-line-kpi">
                            <span>P. Neto total</span>
                            <b id="sumTotalLinea">--</b>
                        </div>
                        <div class="pt-line-kpi">
                            <span>P. Unit. estándar</span>
                            <b id="sumEstandarLinea">--</b>
                        </div>
                        <div class="pt-line-kpi pt-line-kpi-amber">
                            <span>% Sobrepeso</span>
                            <b id="sumSobrePesoLinea">--</b>
                        </div>
                        <div class="pt-line-kpi pt-line-kpi-green">
                            <span>% Eficiencia</span>
                            <b id="sumEficienciaLinea">--</b>
                        </div>
                    </div>

                    <div class="pt-line-head">
                        <h6>Producción por pesada</h6>
                        <button type="button" class="pt-btn pt-btn-sm pt-btn-ghost pt-btn-excel" onclick="generarexcelDetallesLinea()">
                            <i class="fa fa-file-excel-o" aria-hidden="true"></i>
                            Excel
                        </button>
                    </div>

                    <div class="pt-table-scroll">
                        <table id="tableDetalladaLinea" class="table pt-table pt-table-sm">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Código</th>
                                    <th>Atados</th>
                                    <th># de Piezas</th>
                                    <th>P. Neto Total</th>
                                    <th>P. Unitario Estándar</th>
                                    <th>P. Unit. Real</th>
                                    <th>% Sobrepeso</th>
                                    <th>% Eficiencia</th>
                                </tr>
                            </thead>
                            <tbody id="tableBodyDetalleIny" class="text-center">
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="modal-footer-custom">
                    <button type="button" id="cerrarModalDetails" class="btn-modal-cancelar" data-dismiss="modal">
                        <i class="fa fa-times" aria-hidden="true"></i>
                        Cerrar
                    </button>
                </div>

            </div>
        </div>
    </div>

</div>

<script src="~/Scripts/ProductoTerminadoINY/ProductoTermInyJS.js?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Scripts/ProductoTerminadoINY/ProductoTermInyJS.js")).Ticks"></script>
<script src="~/Scripts/FormulasPTM.js"></script>
