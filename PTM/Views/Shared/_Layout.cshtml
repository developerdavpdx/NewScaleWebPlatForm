            <div class="modal-content">

                <div class="cm-header">
                    <div class="cm-header-icon">
                        <i class="fa fa-envelope" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="cm-title" id="myModalLabel">Correos automáticos</div>
                        <div class="cm-subtitle">Destinatarios del reporte que se envía por planta</div>
                    </div>
                    <button type="button" class="cm-close" data-dismiss="modal" aria-label="Cerrar">
                        <i class="fa fa-times" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="cm-body">

