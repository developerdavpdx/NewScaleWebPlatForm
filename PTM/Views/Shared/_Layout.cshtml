                                <input class="form-control cm-input" id="correoInput" type="email" placeholder="nombre@ptmexico.com" autocomplete="off" />
                                <p class="cm-hint">Este correo recibirá el reporte automático de la planta seleccionada.</p>
                            </div>
                            <div id="btn" class="cm-footer">
                                <button type="button" class="cm-btn cm-btn-ghost" data-dismiss="modal" id="cerrarModal">Cerrar</button>
                                <button type="button" class="cm-btn cm-btn-primary" onclick="GuardarCorreo()" id="AsignarLinea">
                                    <i class="fa fa-check" aria-hidden="true"></i>
                                    Asignar
                                </button>
                            </div>
                        </div>

