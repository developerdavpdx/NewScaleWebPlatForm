@{
    ViewBag.Title = "Detalles Orden de Fabricación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Styles/DetallesFO.css?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Styles/DetallesFO.css")).Ticks" rel="stylesheet" />

<div class="dfo-page">

    <div class="dfo-header">
        <div>
            <h2 class="dfo-title">Detalles orden de fabricación</h2>
            <p class="dfo-subtitle">Componentes y cantidades requeridas para la orden seleccionada.</p>
        </div>
        <div class="dfo-tools">
            <span class="dfo-pill" id="pillOrden">
                <i class="fa fa-file-text-o" aria-hidden="true"></i>
                Orden <b id="dfoNumero">—</b>
            </span>
            <span class="dfo-pill" id="pillClave">
                <i class="fa fa-key" aria-hidden="true"></i>
                Clave <b id="dfoClave">—</b>
            </span>
            <span class="dfo-pill">
                <i class="fa fa-cubes" aria-hidden="true"></i>
                <b id="dfoCount">0</b> componentes
            </span>
            <button type="button" class="dfo-btn dfo-btn-outline" onclick="volverAOrdenes()">
                <i class="fa fa-arrow-left" aria-hidden="true"></i>
                Volver
            </button>
            <button type="button" class="dfo-btn dfo-btn-primary" onclick="recargarDetallesOF()">
                <i class="fa fa-refresh" aria-hidden="true"></i>
                Actualizar
            </button>
        </div>
    </div>

    <div class="dfo-card">
        <div class="dfo-card-header">
            <i class="fa fa-list-alt" aria-hidden="true"></i>
            <h5>Componentes de la orden</h5>
            <span class="dfo-card-hint">Código de artículo: <b id="dfoCodigo">—</b></span>
        </div>

        <table id="tablaDetallesOF" class="table dfo-table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th class="text-start">Descripción</th>
                    <th>Cant. base</th>
                    <th>Cant. requerida</th>
                    <th>Cant. planeada</th>
                    <th>Almacén</th>
                    <th>Proceso</th>
                </tr>
            </thead>
            <tbody class="TBOFDetail">
            </tbody>
        </table>
    </div>
</div>

<script src="~/Scripts/DetallesFO/DetallesFO.js?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Scripts/DetallesFO/DetallesFO.js")).Ticks"></script>
