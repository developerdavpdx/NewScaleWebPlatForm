
@{
    ViewBag.Title = "Datos maestros del artículo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Styles/DatosMaestros.css" rel="stylesheet" />
<link href="~/Styles/Modales.css" rel="stylesheet" />

<div class="dm-page">

    <div class="dm-header">
        <div>
            <h2 class="dm-title">Datos maestros del artículo</h2>
            <p class="dm-subtitle">Administra los códigos de artículo, su tara y su última actualización.</p>
        </div>
        <div class="dm-tools">
            <span class="dm-count"><b id="dmCount">0</b> códigos</span>
            <button type="button" class="dm-refresh" onclick="recargarDatosMaestros()">
                <i class="fa fa-rotate-right" aria-hidden="true"></i>
                Actualizar
            </button>
            <button type="button" class="dm-excel" onclick="generarexcelDm();" title="Exportar a Excel">
                <i class="fa fa-table" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn dm-add" data-toggle="modal" data-target="#updateCode">
                Agregar Código
            </button>
        </div>
    </div>

    <div class="dm-card">
        <table id="DatosMaestros" class="table dm-table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th style="width: 33% !important;">Descripción</th>
                    <th>Actualizado</th>
                    <th>Fecha de última actualización</th>
                    <th>Usuario</th>
                    <th>Tara (Kg)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="bodyTableSKU">
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="updateCode" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header-custom">

                <div class="d-flex align-items-center gap-3">

                    <div class="modal-icon-wrap">
                        <i class="bi bi-plus-circle"></i>
                    </div>

                    <div>
                        <div class="modal-title-custom" id="myModalLabel">Agregar Código</div>
                        <div class="modal-subtitle-custom">Registrar nuevo código en el sistema</div>
                    </div>

                </div>

                <button type="button" class="btn-close-custom" data-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>

            </div>

            <!-- BODY -->
            <div class="modal-body-custom">

                <div class="row g-3">

                    <div class="col-12">

                        <label class="form-label-custom" for="updateCodeInp">
                            <i class="bi bi-upc"></i> Código
                        </label>

                        <input class="form-control-custom" id="updateCodeInp" placeholder="Ingrese el código..." />

                    </div>

                </div>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer-custom">

                <button type="button" class="btn-modal-cancelar" data-dismiss="modal" id="CerrarModal">
                    <i class="bi bi-x-circle"></i>
                    Cancelar
                </button>

                <button type="button" class="btn-modal-guardar" onclick="ActualizarItemCode()">
                    <i class="bi bi-check-circle"></i>
                    Agregar
                </button>

            </div>

        </div>
    </div>
</div>

<script src="~/Scripts/DatosMaestros/DatosMaestroJS.js"></script>
@*<script src="~/Scripts/EmailTXT/EmailTXT.js"></script>*@
